# Notification hub service configuration.

# Server
HOST=0.0.0.0
PORT=4500
LOG_LEVEL=INFO

# Worker / thread pool
QUEUE_MAX_SIZE=1000
WORKER_THREAD_POOL_SIZE=8

# Telegram (live channel) — create a bot via @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# SMTP (email channel) — leave blank to run email in simulated/logged mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
